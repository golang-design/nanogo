# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Built binaries. The spikes and cmd/nanogo are built into the tree during
# development and none of them belong in a commit.
/nanogo
/cmd/nanogo/nanogo
/spikes/stackmap/nanogo.spike.stackmap
/spikes/symbolnames/nanogo.spike.symbolnames
/spikes/toolexec/nanogo.spike.toolexec
/spikes/*/spike
/spikes/*/passthrough

# Dependency directories
# vendor/

# Agent worktrees, created under the repository while work runs in parallel.
# They are checkouts of this repository and never belong in a commit.
/.claude/worktrees/
